@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+/** Back off transient chat-list errors without treating them as end of list. */
+public final class ChatLoadRetry {
+  private int consecutiveFailures;
+  private long retryAt;
+
+  public boolean canRequest (long uptimeMillis) { return uptimeMillis >= retryAt; }
+
+  public void failed (long uptimeMillis) {
+    consecutiveFailures = Math.min(6, consecutiveFailures + 1);
+    retryAt = uptimeMillis + Math.min(30000L, 1000L << (consecutiveFailures - 1));
+  }
+
+  public void succeeded () {
+    consecutiveFailures = 0;
+    retryAt = 0;
+  }
+}
