+/** Server gift catalog with recycled, still-frame sticker cards. */
+public final class SviriGiftCatalogController extends RecyclerViewController<Void> {
+  private final ArrayList<TdApi.Gift> gifts = new ArrayList<>();
+  private final ArrayList<Holder> holders = new ArrayList<>();
+  private final CatalogAdapter adapter = new CatalogAdapter();
+  private SviriGiftFlow flow;
+  private boolean loading;
+  private String error;
+  public SviriGiftCatalogController (Context context, Tdlib tdlib) { super(context, tdlib); }
+  @Override public int getId () { return R.id.controller_sviriGiftCatalog; }
+  @Override public CharSequence getName () { return Lang.getString(R.string.SviriGiftBuy); }
+  @Override protected void onCreateView (Context context, CustomRecyclerView recycler) {
+    flow = new SviriGiftFlow(this, tdlib, this::load);
+    GridLayoutManager grid = new GridLayoutManager(context, 3);
+    grid.setSpanSizeLookup(new GridLayoutManager.SpanSizeLookup() {
+      @Override public int getSpanSize (int position) { return position == 0 ? 3 : 1; }
+    });
+    recycler.setLayoutManager(grid); recycler.setItemAnimator(null);
+    recycler.setPadding(Screen.dp(8), Screen.dp(8), Screen.dp(8), Screen.dp(16));
+    recycler.setAdapter(adapter); load();
+  }
+  private void load () {
+    if (isDestroyed() || loading) return;
+    loading = true; error = null; adapter.notifyItemChanged(0);
+    tdlib.client().send(new TdApi.GetAvailableGifts(), result -> runOnUiThreadOptional(() -> {
+      if (isDestroyed()) return;
+      loading = false;
+      if (result instanceof TdApi.AvailableGifts) {
+        gifts.clear();
+        for (TdApi.AvailableGift value : ((TdApi.AvailableGifts) result).gifts) if (GiftSendPolicy.available(value.gift)) gifts.add(value.gift);
+      } else error = result instanceof TdApi.Error ? TD.toErrorString(result) : Lang.getString(R.string.SviriUnexpectedResponse);
+      adapter.notifyDataSetChanged();
+    }));
+  }
+  private final class Holder extends RecyclerView.ViewHolder {
+    final StickerSmallView sticker;
+    final TextView label;
+    Holder (Context context, boolean header) {
+      super(new LinearLayout(context));
+      LinearLayout wrap = (LinearLayout) itemView; wrap.setOrientation(LinearLayout.VERTICAL); wrap.setGravity(Gravity.CENTER);
+      wrap.setPadding(Screen.dp(8), Screen.dp(12), Screen.dp(8), Screen.dp(12));
+      wrap.setLayoutParams(new RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+      if (!header) {
+        GradientDrawable background = new GradientDrawable(); background.setColor(Theme.getColor(ColorId.filling)); background.setCornerRadius(Screen.dp(20)); wrap.setBackground(background);
+        sticker = new StickerSmallView(context) {
+          @Override public boolean onTouchEvent (android.view.MotionEvent event) { return false; }
+        };
+        sticker.init(tdlib); sticker.setForceHeight(Screen.dp(88)); sticker.setEmojiDisabled();
+        wrap.addView(sticker, new LinearLayout.LayoutParams(Screen.dp(88), Screen.dp(88))); holders.add(this);
+      } else sticker = null;
+      label = new TextView(context); label.setTextSize(15); label.setGravity(Gravity.CENTER); label.setTextColor(Theme.getColor(ColorId.text)); wrap.addView(label);
+    }
+  }
+  private final class CatalogAdapter extends RecyclerView.Adapter<Holder> {
+    @Override public int getItemCount () { return gifts.size() + 1; }
+    @Override public int getItemViewType (int position) { return position == 0 ? 0 : 1; }
+    @Override public Holder onCreateViewHolder (ViewGroup parent, int type) { return new Holder(parent.getContext(), type == 0); }
+    @Override public void onBindViewHolder (Holder holder, int position) {
+      if (position == 0) {
+        holder.label.setText(loading ? Lang.getString(R.string.LoadingInformation) : error != null ? error + "\n" + Lang.getString(R.string.SviriRetry) : gifts.isEmpty() ? Lang.getString(R.string.SviriGiftUnavailable) : Lang.getString(R.string.SviriGiftCatalogHint));
+        holder.itemView.setOnClickListener(view -> load()); return;
+      }
+      TdApi.Gift gift = gifts.get(position - 1);
+      TGStickerObj object = new TGStickerObj(tdlib, gift.sticker, null, gift.sticker.fullType);
+      if (object.getPreviewAnimation() != null) object.getPreviewAnimation().setIsStill(true);
+      holder.sticker.setSticker(object);
+      holder.label.setText(gift.sticker.emoji + " · " + gift.starCount + " ★" + (gift.isPremium ? "\nPremium" : ""));
+      holder.itemView.setContentDescription(holder.label.getText());
+      holder.itemView.setOnClickListener(view -> flow.purchase(gift));
+    }
+    @Override public void onViewAttachedToWindow (Holder holder) { if (holder.sticker != null) holder.sticker.attach(); }
+    @Override public void onViewDetachedFromWindow (Holder holder) { if (holder.sticker != null) holder.sticker.detach(); }
+    @Override public void onViewRecycled (Holder holder) { if (holder.sticker != null) holder.sticker.setSticker(null); }
+  }
+  @Override public void destroy () {
+    if (flow != null) flow.destroy();
+    for (Holder holder : holders) holder.sticker.performDestroy();
+    holders.clear(); super.destroy();
+  }
+}
