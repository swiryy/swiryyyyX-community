+
+  public SviriProfileController (Context context, Tdlib tdlib, boolean profile) {
+    super(context, tdlib); this.profile = profile;
+  }
+  @Override public int getId () { return R.id.controller_sviriGifts; }
+  @Override public CharSequence getName () { return Lang.getString(profile ? R.string.SviriProfile : R.string.SviriGifts); }
+  @Override protected void onCreateView (Context context, CustomRecyclerView recycler) {
