+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+import java.util.LinkedHashSet;
+import java.util.function.Consumer;
+
+/** One on-demand metadata snapshot; never sends messages or loads chat history. All callbacks run on the UI thread. */
+public final class FolderForwardLoader {
+  public static final int SNAPSHOT_LIMIT = 10000;
+  public interface Transport {
+    // 0: more loaded, 404: end reached, otherwise an error.
+    void loadMore (Consumer<Integer> callback);
+    void snapshot (Consumer<long[]> callback);
+  }
+  public interface Listener {
+    void complete (long[] ids);
+    void failed ();
+  }
+  private final Transport transport;
+  private final Listener listener;
+  private boolean active;
+  private int generation, pages;
+  public FolderForwardLoader (Transport transport, Listener listener) { this.transport = transport; this.listener = listener; }
+  public void start () { if (active) return; active = true; pages = 0; generation++; more(generation); }
+  public void cancel () { active = false; generation++; }
+  public void timeout () { if (active) fail(); }
+  private boolean current (int token) { return active && token == generation; }
+  private void fail () { cancel(); listener.failed(); }
+  private void more (int token) {
+    if (!current(token)) return;
+    if (++pages > 200) { fail(); return; }
+    transport.loadMore(code -> {
+      if (!current(token)) return;
+      if (code == 0) more(token);
+      else if (code == 404) transport.snapshot(ids -> {
+        if (!current(token)) return;
+        if (ids == null || ids.length >= SNAPSHOT_LIMIT) { fail(); return; }
+        LinkedHashSet<Long> unique = new LinkedHashSet<>();
+        for (long id : ids) if (id != 0) unique.add(id);
+        long[] snapshot = new long[unique.size()]; int i = 0;
+        for (long id : unique) snapshot[i++] = id;
+        cancel(); listener.complete(snapshot);
+      });
+      else fail();
+    });
+  }
+}
