new file mode 100644
index 0000000..568aa9a
--- /dev/null
+++ b/tests/sviri/VisibilityCoreTest.java
@@ -0,0 +1,48 @@
+import org.thunderdog.challegram.telegram.HiddenCounterProjection;
+import org.thunderdog.challegram.telegram.ChatLoadRetry;
+import org.thunderdog.challegram.telegram.PriorityChatPolicy;
+
+public class VisibilityCoreTest {
+  static void check (boolean value, String message) {
+    if (!value) throw new AssertionError(message);
+  }
+
+  public static void main (String[] args) {
+    check(PriorityChatPolicy.eager(true, false, 0), "direct chats are eager without member metadata");
+    check(PriorityChatPolicy.eager(false, false, 200), "200 member boundary is eager");
+    check(!PriorityChatPolicy.eager(false, false, 201), "large groups stay lazy");
+    check(!PriorityChatPolicy.eager(false, true, 12), "even small channels stay lazy");
+    check(!PriorityChatPolicy.eager(false, false, 0), "unknown count is not treated as a small group");
+    check(!PriorityChatPolicy.eager(false, false, -1), "invalid member count stays lazy");
+    HiddenCounterProjection counters = new HiddenCounterProjection();
+    // A muted unread group, an unread private chat with a marker, and a marker-only chat.
+    counters.add(7, false, false);
+    counters.add(3, true, true);
+    counters.add(0, true, true);
+    check(counters.visible(HiddenCounterProjection.TOTAL, 400) == 397, "total count");
+    check(counters.visible(HiddenCounterProjection.CHATS, 8) == 5, "marked and messages overlap only once");
+    check(counters.visible(HiddenCounterProjection.UNMUTED_CHATS, 5) == 3, "muted chat excluded only from all chats");
+    check(counters.visible(HiddenCounterProjection.MARKED, 4) == 2, "marker-only chats");
+    check(counters.visible(HiddenCounterProjection.MESSAGES, 25) == 15, "message count");
+    check(counters.visible(HiddenCounterProjection.UNMUTED_MESSAGES, 10) == 7, "unmuted message count");
+    check(counters.visible(HiddenCounterProjection.CHATS, -1) == -1, "unknown is not empty");
+    check(counters.visible(HiddenCounterProjection.CHATS, 1) == 0, "approximate totals never turn negative");
+    counters.add(Integer.MAX_VALUE, false, true);
+    counters.add(Integer.MAX_VALUE, false, true);
+    check(counters.visible(HiddenCounterProjection.MESSAGES, Integer.MAX_VALUE) == 0, "large unread counts do not overflow");
+
+    ChatLoadRetry retry = new ChatLoadRetry();
+    check(retry.canRequest(0), "first request can start");
+    retry.failed(100);
+    check(!retry.canRequest(1099) && retry.canRequest(1100), "first failure retries at boundary");
+    retry.failed(1100);
+    check(!retry.canRequest(3099) && retry.canRequest(3100), "repeated error increases backoff");
+    for (int i = 0; i < 20; i++) retry.failed(10000);
+    check(!retry.canRequest(39999) && retry.canRequest(40000), "backoff capped at 30 seconds");
+    retry.succeeded();
+    check(retry.canRequest(10000), "success clears backoff");
+    retry.failed(10000);
+    check(retry.canRequest(11000), "new failure starts at one second again");
+    System.out.println("PASS: visible counts, muted/marked overlap, unknown values, overflow and network retry timeline");
+  }
+}
