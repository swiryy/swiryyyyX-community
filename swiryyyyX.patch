@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+import android.widget.Toast;
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.R;
+import org.thunderdog.challegram.core.Lang;
+import org.thunderdog.challegram.tool.UI;
+import org.thunderdog.challegram.unsorted.Settings;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+
+/** UI-thread queue owner independent of the dismissed share window. No automatic replay. */
+public final class FolderForwardTask {
+  private static final HashMap<Integer, FolderForwardTask> active = new HashMap<>();
+  private static final String JOB_ID = "swir-folder-forward";
+  public static final class Batch {
+    final long chatId;
+    final List<TdApi.Function<?>> functions;
+    public Batch (long chatId, List<TdApi.Function<?>> functions) {
+      this.chatId = chatId; this.functions = new ArrayList<>(functions);
+    }
+  }
+  private final Tdlib tdlib;
+  private final long sourceUserId;
+  private final ArrayList<Batch> batches;
+  private final FolderForwardSender sender;
+  private final FolderForwardQueue queue;
+
+  /** Returns an error without starting, or null once ownership has transferred to this task. */
+  public static String start (Tdlib tdlib, List<Batch> batches) {
+    if (active.containsKey(tdlib.id())) return Lang.getString(R.string.SviriFolderBusy);
+    if (batches.isEmpty()) return Lang.getString(R.string.SviriFolderLoadFailed);
+    long remaining = Settings.instance().getLong("sviri_forward_cooldown_" + tdlib.id(), 0) - System.currentTimeMillis();
+    if (remaining > 0) return Lang.getString(R.string.SviriFolderCooldown, (remaining + 999L) / 1000L);
+    FolderForwardTask task = new FolderForwardTask(tdlib, batches);
+    active.put(tdlib.id(), task);
+    tdlib.incrementJobReferenceCount(JOB_ID);
+    task.queue.start();
+    return null;
+  }
+  private FolderForwardTask (Tdlib tdlib, List<Batch> batches) {
+    this.tdlib = tdlib; this.sourceUserId = tdlib.myUserId(); this.batches = new ArrayList<>(batches);
+    sender = new FolderForwardSender(tdlib);
+    queue = new FolderForwardQueue(batches.size(), (index, callback) -> {
+      if (tdlib.myUserId() != sourceUserId) { callback.accept(Lang.getString(R.string.SviriAccountChanged)); return; }
+      Batch batch = this.batches.get(index);
+      if (tdlib.settings().isChatHidden(batch.chatId)) {
+        callback.accept(Lang.getString(R.string.SviriFolderRecipientChanged)); return;
+      }
+      // Permissions were checked in the picker; TDLib validates again on each send.
+      sender.send(batch.chatId, batch.functions, callback);
+    }, UI::post, new FolderForwardQueue.Listener() {
+      @Override public void progress (int completed, int total) { }
+      @Override public void finished () { finish(null); }
+      @Override public void failed (String error) { finish(error); }
+    });
+  }
+  private void finish (String error) {
+    int completed = queue.completed(), total = batches.size();
+    sender.cancel(); active.remove(tdlib.id()); batches.clear();
+    tdlib.decrementJobReferenceCount(JOB_ID);
+    UI.showToast(error == null ? Lang.getString(R.string.SviriFolderFinished, completed)
+      : Lang.getString(R.string.SviriFolderStopped, completed, total, error), Toast.LENGTH_LONG);
+  }
+}
