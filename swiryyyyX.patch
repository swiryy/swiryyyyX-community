+#!/usr/bin/env python3
+"""Exercise the actual Tdlib balance code without an Android/TDLib runtime."""
+from pathlib import Path
+import subprocess, tempfile
+root=Path(__file__).resolve().parents[2]
+s=(root/'app/src/main/java/org/thunderdog/challegram/telegram/Tdlib.java').read_text()
+code=s[s.index('  private volatile TdApi.StarAmount ownedStarAmount;'):s.index('  @TdlibThread\n  private void updateOwnedGramCount')].replace('  @TdlibThread\n','')
+source='''import java.util.*;
+class TdApi {
+ static class StarAmount {long starCount;int nanostarCount;StarAmount(long n,int f){starCount=n;nanostarCount=f;}}
+ static class UpdateOwnedStarCount {StarAmount starAmount;UpdateOwnedStarCount(long n){starAmount=new StarAmount(n,0);}}
+}
+class UI { static final List<Runnable> queue=new ArrayList<>(); static void post(Runnable r){queue.add(r);} static void drain(){while(!queue.isEmpty())queue.remove(0).run();}}
+public class StarsStateTest {
+ long user=1;long myUserId(){return user;}
+'''+code+'''
+ static void check(boolean v){if(!v)throw new AssertionError();}
+ public static void main(String[]args){
+  StarsStateTest state=new StarsStateTest(); List<Long> events=new ArrayList<>();
+  state.addStarAmountListener(value->events.add(value.starCount));
+  check(state.ownedStarAmount()==null);
+  long pending=state.ownedStarAmountRevision();
+  state.updateOwnedStarCount(new TdApi.UpdateOwnedStarCount(120));
+  state.rememberOwnedStarAmount(1,pending,new TdApi.StarAmount(10,0));
+  check(state.ownedStarAmount().starCount==120); UI.drain();check(events.equals(List.of(120L)));
+  state.updateOwnedStarCount(new TdApi.UpdateOwnedStarCount(121));
+  state.updateOwnedStarCount(new TdApi.UpdateOwnedStarCount(122));
+  UI.drain();check(events.equals(List.of(120L,122L)));
+  state.user=2;check(state.ownedStarAmount()==null);
+  state.rememberOwnedStarAmount(1,state.ownedStarAmountRevision(),new TdApi.StarAmount(900,0));
+  check(state.ownedStarAmount()==null);
+  state.rememberOwnedStarAmount(2,state.ownedStarAmountRevision(),new TdApi.StarAmount(7,500000000));
+  check(state.ownedStarAmount().starCount==7&&state.ownedStarAmount().nanostarCount==500000000);
+  state.user=3;UI.drain();check(events.equals(List.of(120L,122L)));
+  System.out.println("PASS: live Stars balance, stale history, coalesced updates and account isolation");
+ }
+}'''
+with tempfile.TemporaryDirectory() as temp:
+ p=Path(temp)/'StarsStateTest.java';p.write_text(source)
+ subprocess.run(['java','com.sun.tools.javac.Main','-d',temp,str(p)],check=True)
+ subprocess.run(['java','-cp',temp,'StarsStateTest'],check=True)
