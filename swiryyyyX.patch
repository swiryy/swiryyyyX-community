+    int end = Math.min(offset + 16, ids.length);
+    java.util.concurrent.atomic.AtomicInteger remaining = new java.util.concurrent.atomic.AtomicInteger(end - offset);
+    for (int i = offset; i < end; i++) {
+      // GetChat reads TDLib's local chat database; it does not download histories.
+      send(new TdApi.GetChat(ids[i]), (chat, error) -> {
+        if (remaining.decrementAndGet() == 0) {
