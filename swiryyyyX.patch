+      TextViewCompat.setCompoundDrawableTintList(tab, ColorStateList.valueOf(Theme.getColor(color)));
+      addThemeTextColorListener(tab, color); addThemeCompoundDrawableColorListener(tab, color);
+      tab.setOnClickListener(view -> {
