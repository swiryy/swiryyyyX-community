+    recycler.setLayoutManager(grid);
+    recycler.setPadding(Screen.dp(10), Screen.dp(8), Screen.dp(10), Screen.dp(16));
+    recycler.setClipToPadding(false);
+    if (profile) {
+      FrameLayout.LayoutParams params = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT);
+      params.bottomMargin = Screen.dp(84); recycler.setLayoutParams(params);
+      tdlib.addStarAmountListener(balanceListener); loadBalance();
+    }
+    recycler.setItemAnimator(null);
+    adapter = new GalleryAdapter();
+    recycler.setAdapter(adapter);
+    recycler.addOnScrollListener(new RecyclerView.OnScrollListener() {
+      @Override public void onScrolled (RecyclerView view, int dx, int dy) {
+        if (dy > 0 && grid.findLastVisibleItemPosition() >= adapter.getItemCount() - 5 && error == null && !offset.isEmpty()) load();
+      }
+    });
+    load();
+    if (profile) tdlib.client().send(new TdApi.GetUserFullInfo(tdlib.myUserId()), result -> runOnUiThreadOptional(() -> {
+      if (!isDestroyed() && result instanceof TdApi.UserFullInfo) {
+        TdApi.FormattedText value = ((TdApi.UserFullInfo) result).bio;
+        bio = value != null ? value.text : "";
+        update();
+      }
+    }));
+  }
+  private void load () {
+    if (loading || isDestroyed() || (loaded && offset.isEmpty() && error == null)) return;
+    loading = true; error = null; update();
+    int token = generation;
+    TdApi.GetReceivedGifts request = new TdApi.GetReceivedGifts();
+    request.businessConnectionId = "";
+    request.ownerId = new TdApi.MessageSenderUser(tdlib.myUserId());
+    // All kinds: ordinary, limited, upgradable and upgraded gifts.
+    request.offset = offset; request.limit = 30;
+    tdlib.client().send(request, result -> runOnUiThreadOptional(() -> {
+      if (isDestroyed() || token != generation) return;
+      loading = false;
+      if (result instanceof TdApi.ReceivedGifts) {
+        TdApi.ReceivedGifts page = (TdApi.ReceivedGifts) result;
+        giftCount = page.totalCount;
+        for (TdApi.ReceivedGift gift : page.gifts) {
+          if ((gift.gift instanceof TdApi.SentGiftRegular || gift.gift instanceof TdApi.SentGiftUpgraded) && seen.add(gift.receivedGiftId)) gifts.add(gift);
+        }
+        offset = page.nextOffset; loaded = true;
+      } else error = result instanceof TdApi.Error ? TD.toErrorString(result) : Lang.getString(R.string.SviriUnexpectedResponse);
+      update();
+    }));
+  }
+  private void update () { if (adapter != null && !isDestroyed()) adapter.notifyDataSetChanged(); }
+  private TextView text (Context context, CharSequence value, int size) {
+    TextView view = new TextView(context);
+    view.setText(value); view.setTextSize(size); view.setTextColor(Theme.getColor(ColorId.text));
+    view.setGravity(Gravity.CENTER); view.setPadding(Screen.dp(12), Screen.dp(10), Screen.dp(12), Screen.dp(10));
+    return view;
+  }
+  private LinearLayout column (Context context) {
+    LinearLayout view = new LinearLayout(context); view.setOrientation(LinearLayout.VERTICAL); view.setGravity(Gravity.CENTER);
+    view.setLayoutParams(new RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+    return view;
+  }
+  private void showGift (TdApi.ReceivedGift received) {
+    if (received.gift instanceof TdApi.SentGiftUpgraded) {
+      TdApi.UpgradedGift gift = ((TdApi.SentGiftUpgraded) received.gift).gift;
+      String details = gift.title + " #" + gift.number + "\n" + Lang.getString(R.string.SviriGiftModel) + ": " + gift.model.name + "\n" + Lang.getString(R.string.SviriGiftSymbol) + ": " + gift.symbol.name + "\n" + Lang.getString(R.string.SviriGiftBackdrop) + ": " + gift.backdrop.name;
+      showOptions(details, new int[]{R.id.btn_sviriTransferGift, R.id.btn_sviriOpenGift, R.id.btn_cancel}, new String[]{Lang.getString(R.string.SviriGiftTransferAction), Lang.getString(R.string.SviriOpenGift), Lang.getString(R.string.Cancel)}, null, new int[]{R.drawable.baseline_share_24, R.drawable.dotvhs_baseline_gift_24, R.drawable.baseline_cancel_24}, (view, id) -> {
+        if (id == R.id.btn_sviriTransferGift) giftFlow.transfer(received);
+        if (id == R.id.btn_sviriOpenGift) tdlib.ui().openUrl(this, "https://t.me/nft/" + gift.name, null);
+        return true;
+      });
+    } else {
+      TdApi.Gift gift = ((TdApi.SentGiftRegular) received.gift).gift;
+      String caption = gift.sticker.emoji + " · " + gift.starCount + " ★";
+      if (received.text != null && !received.text.text.isEmpty()) caption += "\n" + received.text.text;
+      showOptions(caption, new int[]{R.id.btn_cancel}, new String[]{Lang.getString(R.string.Cancel)}, null, new int[]{R.drawable.baseline_cancel_24}, (view, id) -> true);
+    }
+  }
+  private final class Card extends RecyclerView.ViewHolder {
+    final StickerSmallView sticker;
+    final TextView title, subtitle;
+    final LinearLayout panel;
+    Card (Context context) {
+      super(column(context));
+      LinearLayout outer = (LinearLayout) itemView;
+      outer.setPadding(Screen.dp(5), Screen.dp(5), Screen.dp(5), Screen.dp(5));
+      panel = column(context);
+      panel.setPadding(0, Screen.dp(6), 0, Screen.dp(8));
+      outer.addView(panel);
+      sticker = new StickerSmallView(context) {
+        @Override public boolean onTouchEvent (android.view.MotionEvent event) { return false; }
+      };
+      sticker.init(tdlib); sticker.setForceHeight(Screen.dp(94));
+      panel.addView(sticker, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, Screen.dp(94)));
+      title = text(context, "", 12); title.setMaxLines(2);
+      subtitle = text(context, "", 11);
+      panel.addView(title); panel.addView(subtitle);
+      cards.add(this);
+    }
+    void bind (TdApi.ReceivedGift received) {
+      TdApi.Sticker image;
+      int start = Theme.getColor(ColorId.filling), end = start, foreground = Theme.getColor(ColorId.text);
+      if (received.gift instanceof TdApi.SentGiftUpgraded) {
+        TdApi.UpgradedGift gift = ((TdApi.SentGiftUpgraded) received.gift).gift;
+        image = gift.model.sticker;
+        start = 0xff000000 | gift.backdrop.colors.centerColor;
+        end = 0xff000000 | gift.backdrop.colors.edgeColor;
+        foreground = 0xff000000 | gift.backdrop.colors.textColor;
+        title.setText(gift.title); subtitle.setText("#" + gift.number);
+      } else {
+        TdApi.Gift gift = ((TdApi.SentGiftRegular) received.gift).gift;
+        image = gift.sticker; title.setText(image.emoji + " " + Lang.getString(R.string.SviriReceivedGift));
+        subtitle.setText(gift.starCount + " ★");
+      }
+      GradientDrawable background = new GradientDrawable(GradientDrawable.Orientation.TL_BR, new int[]{start, end});
+      background.setCornerRadius(Screen.dp(20)); panel.setBackground(background);
+      title.setTextColor(foreground); subtitle.setTextColor(foreground);
+      TGStickerObj object = new TGStickerObj(tdlib, image, null, image.fullType);
+      // Native first-frame decoding: no continuously running animations in the grid.
+      if (object.getPreviewAnimation() != null) object.getPreviewAnimation().setIsStill(true);
+      sticker.setSticker(object);
+      panel.setOnClickListener(view -> showGift(received));
+      panel.setContentDescription(title.getText() + " " + subtitle.getText());
+    }
+  }
+  private final class GalleryAdapter extends RecyclerView.Adapter<RecyclerView.ViewHolder> {
+    int prefix () { return profile ? 2 : 1; }
+    @Override public int getItemCount () { return prefix() + gifts.size() + 1; }
+    @Override public int getItemViewType (int position) {
+      if (profile && position == 0) return 0;
+      if (position < prefix()) return 2;
+      return position < prefix() + gifts.size() ? 1 : 3;
+    }
+    @Override public RecyclerView.ViewHolder onCreateViewHolder (ViewGroup parent, int type) {
+      Context context = parent.getContext();
+      if (type == 1) return new Card(context);
+      LinearLayout wrap = column(context);
+      if (type == 0) {
+        AvatarView avatar = new AvatarView(context); avatar.setUser(tdlib, tdlib.myUserId(), false);
+        avatars.add(avatar); wrap.addView(avatar, new LinearLayout.LayoutParams(Screen.dp(104), Screen.dp(104)));
+        wrap.addView(text(context, tdlib.cache().userName(tdlib.myUserId()), 24));
+        TextView stars = text(context, Lang.getString(R.string.SviriStars) + " ★", 16);
+        stars.setTextColor(Theme.getColor(ColorId.textLink));
+        stars.setOnClickListener(view -> navigateTo(new SettingsStarsController(context, tdlib, false)));
+        wrap.addView(stars);
+        LinearLayout info = column(context); info.setPadding(Screen.dp(10), Screen.dp(8), Screen.dp(10), Screen.dp(8));
+        GradientDrawable panel = new GradientDrawable(); panel.setColor(Theme.getColor(ColorId.filling)); panel.setCornerRadius(Screen.dp(24)); info.setBackground(panel);
+        for (int i = 0; i < 6; i++) {
+          TextView field = text(context, "", i % 2 == 0 ? 16 : 12); field.setGravity(Gravity.START); field.setPadding(Screen.dp(8), Screen.dp(5), Screen.dp(8), Screen.dp(5));
+          if (i % 2 == 1) field.setTextColor(Theme.getColor(ColorId.textLight)); info.addView(field);
+        }
+        wrap.addView(info);
+        TextView settings = text(context, Lang.getString(R.string.Settings), 15);
+        settings.setTextColor(Theme.getColor(ColorId.textLink));
+        settings.setOnClickListener(view -> navigateTo(new SettingsController(context, tdlib)));
+        wrap.addView(settings);
+        TextView buy = text(context, Lang.getString(R.string.SviriGiftBuy), 16);
+        buy.setTextColor(Theme.getColor(ColorId.textLink));
+        buy.setOnClickListener(view -> navigateTo(new SviriGiftCatalogController(context, tdlib)));
+        wrap.addView(buy);
+      } else wrap.addView(text(context, "", type == 2 ? 20 : 15));
+      return new RecyclerView.ViewHolder(wrap) {};
+    }
+    @Override public void onBindViewHolder (RecyclerView.ViewHolder holder, int position) {
+      int type = getItemViewType(position);
+      if (type == 1) ((Card) holder).bind(gifts.get(position - prefix()));
+      else if (type == 0) {
+        LinearLayout wrap = (LinearLayout) holder.itemView;
+        TdApi.User user = tdlib.cache().user(tdlib.myUserId());
+        String username = user != null && user.usernames != null && user.usernames.activeUsernames.length > 0 ? "@" + user.usernames.activeUsernames[0] : "";
+        LinearLayout info = (LinearLayout) wrap.getChildAt(3);
+        String[] values = {user != null && user.phoneNumber != null && !user.phoneNumber.isEmpty() ? "+" + user.phoneNumber : "", bio, username};
+        String[] labels = {Lang.getString(R.string.SviriPhone), Lang.getString(R.string.SviriBio), Lang.getString(R.string.SviriUsername)};
+        boolean hasInfo = false;
+        for (int i = 0; i < 3; i++) {
+          TextView value = (TextView) info.getChildAt(i * 2), label = (TextView) info.getChildAt(i * 2 + 1);
+          value.setText(values[i]); label.setText(labels[i]);
+          value.setVisibility(values[i].isEmpty() ? View.GONE : View.VISIBLE); label.setVisibility(value.getVisibility());
+          hasInfo |= !values[i].isEmpty();
+        }
+        info.setVisibility(hasInfo ? View.VISIBLE : View.GONE);
+        TdApi.StarAmount balance = tdlib.ownedStarAmount();
+        ((TextView) wrap.getChildAt(2)).setText("★ " + (balance != null ? SettingsStarsController.amount(balance) : balanceLoading ? "…" : Lang.getString(R.string.SviriRetry)) + " · " + Lang.getString(R.string.SviriStars));
+      } else {
+        TextView label = (TextView) ((LinearLayout) holder.itemView).getChildAt(0);
+        if (type == 2) {
+          label.setText(Lang.getString(R.string.SviriGifts) + (giftCount > 0 ? " · " + giftCount : "")); label.setTextColor(Theme.getColor(ColorId.textLink)); label.setTextSize(16);
+          label.setContentDescription(Lang.getString(R.string.SviriGiftBuy));
+          label.setOnClickListener(view -> navigateTo(new SviriGiftCatalogController(context(), tdlib)));
+          GradientDrawable pill = new GradientDrawable(); pill.setColor(0x22339fed); pill.setCornerRadius(Screen.dp(28)); label.setBackground(pill);
+          LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT); params.setMargins(0, Screen.dp(14), 0, Screen.dp(12)); label.setLayoutParams(params);
+        }
+        else {
+          label.setText(loading ? Lang.getString(R.string.LoadingInformation) : error != null ? error + "\n" + Lang.getString(R.string.SviriRetry) : !offset.isEmpty() ? Lang.getString(R.string.SviriLoadMore) : gifts.isEmpty() ? Lang.getString(R.string.SviriNoGifts) : Lang.getString(R.string.SviriRefresh));
+          holder.itemView.setOnClickListener(view -> {
+            if (loading) return;
+            if (error != null || !offset.isEmpty()) load();
+            else { generation++; gifts.clear(); seen.clear(); loaded = false; offset = ""; load(); }
+          });
+        }
+      }
+    }
+    @Override public void onViewAttachedToWindow (RecyclerView.ViewHolder holder) { if (holder instanceof Card) ((Card) holder).sticker.attach(); }
+    @Override public void onViewDetachedFromWindow (RecyclerView.ViewHolder holder) { if (holder instanceof Card) ((Card) holder).sticker.detach(); }
+    @Override public void onViewRecycled (RecyclerView.ViewHolder holder) { if (holder instanceof Card) ((Card) holder).sticker.setSticker(null); }
+  }
+  @Override public void destroy () {
+    if (giftFlow != null) giftFlow.destroy();
+    generation++;
+    tdlib.removeStarAmountListener(balanceListener);
+    for (Card card : cards) card.sticker.performDestroy();
+    for (AvatarView avatar : avatars) avatar.performDestroy();
+    cards.clear(); avatars.clear();
+    super.destroy();
+  }
+}
