+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.tool.UI;
+import java.util.HashSet;
+import java.util.function.Consumer;
+
+/** One user-confirmed gift write per account. Never retry financial operations automatically. */
+public final class GiftPaymentTask {
+  private static final HashSet<Integer> active = new HashSet<>();
+  public static boolean send (Tdlib tdlib, TdApi.Function<?> request, Consumer<TdApi.Object> callback) {
+    if (!(request instanceof TdApi.SendGift || request instanceof TdApi.TransferGift)) throw new IllegalArgumentException();
+    if (!active.add(tdlib.id())) return false;
+    tdlib.incrementJobReferenceCount("swir-gift-payment");
+    final boolean[] finished = {false};
+    tdlib.client().send(request, result -> UI.post(() -> {
+      if (finished[0]) return;
+      finished[0] = true;
+      active.remove(tdlib.id());
+      tdlib.decrementJobReferenceCount("swir-gift-payment");
+      callback.accept(result);
+    }));
+    return true;
+  }
+}
