+import java.util.*;
+import java.util.function.Consumer;
+import org.thunderdog.challegram.telegram.FolderForwardLoader;
+public class FolderForwardLoaderTest {
+  static class Transport implements FolderForwardLoader.Transport {
+    ArrayDeque<Consumer<Integer>> loads=new ArrayDeque<>();
+    Consumer<long[]> snapshot;
+    int calls;
+    public void loadMore(Consumer<Integer> cb){calls++;loads.add(cb);}
+    public void snapshot(Consumer<long[]> cb){snapshot=cb;}
+    void reply(int code){loads.remove().accept(code);}
+  }
+  static class Result implements FolderForwardLoader.Listener {
+    long[] ids;int errors,completions;
+    public void complete(long[] value){ids=value;completions++;}
+    public void failed(){errors++;}
+  }
+  static void check(boolean value){if(!value)throw new AssertionError();}
+  public static void main(String[] args){
+    Transport t=new Transport();Result r=new Result();FolderForwardLoader l=new FolderForwardLoader(t,r);
+    l.start();l.start();check(t.calls==1);
+    for(int i=0;i<4;i++)t.reply(0);
+    check(r.completions==0&&t.snapshot==null);t.reply(404);check(t.snapshot!=null);
+    long[] ids=new long[402];for(int i=0;i<400;i++)ids[i]=i+1;ids[400]=1;ids[401]=0;
+    t.snapshot.accept(ids);check(r.ids.length==400&&r.ids[0]==1&&r.ids[399]==400&&r.completions==1);
+    l.start();t.reply(429);check(r.errors==1&&r.completions==1);
+    l.start();Consumer<Integer> old=t.loads.remove();l.cancel();old.accept(404);check(r.completions==1);
+    l.start();l.timeout();check(r.errors==2);t.reply(0);check(r.errors==2);
+    l.start();t.reply(404);t.snapshot.accept(new long[10000]);check(r.errors==3);
+    l.start();t.reply(404);t.snapshot.accept(null);check(r.errors==4);
+    l.start();t.reply(404);t.snapshot.accept(new long[0]);check(r.ids.length==0&&r.completions==2);
+    l.start();for(int i=0;i<200;i++)t.reply(0);check(r.errors==5);
+    System.out.println("PASS: 400 folder recipients, deduplication, repeated taps, errors, cancellation, timeout, snapshot limits and empty folders");
+  }
+}
