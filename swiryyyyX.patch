+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+import org.drinkless.tdlib.TdApi;
+
+/** Checks server-provided gift metadata before presenting or accepting a price. */
+public final class GiftSendPolicy {
+  private GiftSendPolicy () { }
+  public static boolean available (TdApi.Gift gift) {
+    return gift != null && gift.id != 0 && gift.starCount >= 0 && gift.auctionInfo == null
+      && (gift.userLimits == null || gift.userLimits.remainingCount > 0)
+      && (gift.overallLimits == null || gift.overallLimits.remainingCount > 0);
+  }
+  public static boolean transferable (TdApi.ReceivedGift gift, long nowSeconds) {
+    return gift != null && gift.receivedGiftId != null && !gift.receivedGiftId.isEmpty()
+      && gift.gift instanceof TdApi.SentGiftUpgraded && gift.canBeTransferred && !gift.wasRefunded
+      && gift.transferStarCount >= 0 && gift.nextTransferDate <= nowSeconds;
+  }
+  public static boolean enoughStars (TdApi.StarAmount balance, long cost) {
+    return balance != null && cost >= 0 && (balance.starCount > cost
+      || balance.starCount == cost && balance.nanostarCount >= 0);
+  }
+  /** A quote can authorize exactly one write, and only at its displayed price and recipient. */
+  public static final class Confirmation {
+    public final long userId, starCount;
+    private boolean used;
+    public Confirmation (long userId, long starCount) { this.userId = userId; this.starCount = starCount; }
+    public boolean consume (long currentUserId, long currentStarCount) {
+      if (used || userId <= 0 || starCount < 0 || currentUserId != userId || currentStarCount != starCount) return false;
+      used = true; return true;
+    }
+  }
+}
