+#!/usr/bin/env python3
+"""Run standalone Java checks without downloading Gradle or Android SDK."""
+from pathlib import Path
+import subprocess
+import tempfile
+import xml.etree.ElementTree as ET
+
+root = Path(__file__).resolve().parents[2]
+package = root / 'app/src/main/java/org/thunderdog/challegram'
+tests = Path(__file__).resolve().parent
+with tempfile.TemporaryDirectory() as tmp:
+    subprocess.run(['java', 'com.sun.tools.javac.Main', '-d', tmp,
+                    str(package / 'telegram/HiddenChatStore.java'),
+                    str(package / 'telegram/HiddenCounterProjection.java'),
+                    str(package / 'telegram/ChatLoadRetry.java'),
+                    str(package / 'telegram/PriorityChatPolicy.java'),
+                    str(package / 'telegram/FolderForwardLoader.java'),
+                    str(package / 'telegram/FolderForwardQueue.java'),
+                    str(tests / 'FolderForwardQueueTest.java'),
+                    str(tests / 'FolderForwardLoaderTest.java'),
+                    str(tests / 'VisibilityCoreTest.java'),
+                    str(tests / 'HiddenChatStoreTest.java'),
+                    str(tests / 'ParseSources.java')], check=True)
+    subprocess.run(['java', '-cp', tmp, 'HiddenChatStoreTest'], check=True)
+    subprocess.run(['java', '-cp', tmp, 'VisibilityCoreTest'], check=True)
+    subprocess.run(['java', '-cp', tmp, 'FolderForwardLoaderTest'], check=True)
+    subprocess.run(['java', '-cp', tmp, 'FolderForwardQueueTest'], check=True)
+    modified = subprocess.check_output(['git', 'diff', 'HEAD', '--name-only'], cwd=root, text=True).splitlines()
+    untracked = subprocess.check_output(['git', 'ls-files', '--others', '--exclude-standard'], cwd=root, text=True).splitlines()
+    sources = [str(root / path) for path in dict.fromkeys(modified + untracked)
+               if path.startswith('app/src/main/java/') and path.endswith('.java')]
+    subprocess.run(['java', '-cp', tmp, 'ParseSources', *sources], check=True)
+
+for relative in ('app/src/main/res/values/ids.xml', 'app/src/main/res/values/strings.xml'):
+    tree = ET.parse(root / relative)
+    names = [entry.get('name') for entry in tree.getroot()]
+    assert len(names) == len(set(names)), f'duplicate resource in {relative}'
+print('PASS: XML resources parse and have unique names')
+theme_root = root / 'app/src/main/other/themes'
+definitions = ET.parse(theme_root / 'colors-and-properties.xml').getroot()
+allowed = {
+    '@': {item.get('name') for item in definitions.find('properties')},
+    '#': {item.get('name') for item in definitions.find('colors')},
+}
+section = None
+for line in (theme_root / 'swiryyyyX Dark.tgx-theme').read_text().splitlines():
+    if line in ('!', '@', '#'):
+        section = line
+    elif section in allowed and ':' in line:
+        names = {name.strip() for name in line.split(':', 1)[0].split(',')}
+        assert names <= allowed[section], f'unknown theme entries: {names - allowed[section]}'
+assert definitions.find('settings/default-theme/dark').text == '12'
+print('PASS: swiryyyyX theme entries and default dark theme')
+subprocess.run(['git', 'diff', '--check'], cwd=root, check=True)
