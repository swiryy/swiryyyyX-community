+#!/usr/bin/env python3
+"""Execute the production theme loader against generated-theme dependency stubs.
+
+This catches built-in themes that compile successfully but fall through to the
+custom-theme branch at startup. Android rendering is outside this test's scope.
+"""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+package = 'org.thunderdog.challegram.theme'
+source = root / 'app/src/main/java/org/thunderdog/challegram/theme/ThemeSet.java'
+themes = []
+for path in (root / 'app/src/main/other/themes').glob('*.tgx-theme'):
+    content = path.read_text()
+    theme_id = int(re.search(r'^id: (\d+)', content, re.M).group(1))
+    name = re.search(r'^name: "([^"]+)"', content, re.M)
+    name = name.group(1) if name else path.stem
+    class_name = name.replace(' ', '')
+    constant = ''.join(('_' if i and c.isupper() else '') + c.upper()
+                       for i, c in enumerate(class_name))
+    themes.append((theme_id, class_name, constant))
+with tempfile.TemporaryDirectory() as tmp:
+    tmp = Path(tmp)
+    def write(name, text):
+        path = tmp / (name.replace('.', '/') + '.java')
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text)
+    for annotation in ('ColorInt', 'NonNull'):
+        write('androidx.annotation.' + annotation,
+              'package androidx.annotation; public @interface ' + annotation + ' {}')
+    constants = '\n'.join(f'int {name} = {i};' for i, _, name in themes)
+    write(package + '.ThemeId', f'package {package}; public @interface ThemeId {{'
+          + 'int NONE = 0, TEMPORARY = -1, CUSTOM = -2, ID_MIN = 1, COUNT = 12;'
+          + constants + '}')
+    for annotation in ('ColorId', 'PropertyId'):
+        write(package + '.' + annotation,
+              f'package {package}; public @interface {annotation} {{ int WALLPAPER_ID = 0; }}')
+    write(package + '.ThemeDelegate', f'package {package}; public class ThemeDelegate {{'
+          + 'private final int id; public ThemeDelegate(int id) { this.id = id; }'
+          + 'public int getColor(int c) { return id; } public float getProperty(int p) { return id; }'
+          + 'public String getDefaultWallpaper() { return "theme-" + id; }}')
+    write(package + '.ThemeManager', f'package {package}; public class ThemeManager {{'
+          + 'public static int resolveCustomThemeId(int id) { return 100 + id; }}')
+    write(package + '.TGBackground', f'package {package}; public class TGBackground {{'
+          + 'public static String getBackgroundForLegacyWallpaperId(int id) { return "legacy"; }}')
+    write('org.thunderdog.challegram.unsorted.Settings', '''package org.thunderdog.challegram.unsorted;
+import org.thunderdog.challegram.theme.ThemeDelegate;
+public class Settings {
+ public static Settings instance() { return new Settings(); }
+ public int getCustomThemeColor(int t, int c) { return -1; }
+ public float getCustomThemeProperty(int t, int p) { return -1; }
+ public String getCustomThemeWallpaper(int t) { return null; }
+ public ThemeDelegate loadCustomTheme(int t) { throw new AssertionError("Unexpected custom theme " + t); }
+}''')
+    for theme_id, name, _ in themes:
+        # Blue is the source theme and the generator calls it ThemeDefault.
+        generated = 'ThemeDefault' if name == 'Blue' else 'Theme' + name
+        write(package + '.builtin.' + generated,
+              f'package {package}.builtin; public class {generated} extends {package}.ThemeDelegate {{'
+              + f'public {generated}() {{ super({theme_id}); }}' + '}')
+    write(package + '.ThemeSet', source.read_text())
+    ids = ','.join(str(i) for i, _, _ in themes)
+    write('ThemeLoaderTest', f'''import {package}.ThemeSet;
+public class ThemeLoaderTest {{
+ public static void main(String[] args) {{
+  for (int id : new int[] {{{ids}}}) {{
+   if (ThemeSet.getColor(id, 0) != id) throw new AssertionError("Wrong theme " + id);
+   if (ThemeSet.getProperty(id, 0) != id) throw new AssertionError("Wrong property " + id);
+   if (!ThemeSet.getDefaultWallpaper(id).equals("theme-" + id)) throw new AssertionError("Wrong wallpaper");
+  }}
+  System.out.println("PASS: all 12 built-in themes load, including the default swiryyyyX theme");
+ }}
+}}''')
+    subprocess.run(['java', 'com.sun.tools.javac.Main', '-d', str(tmp),
+                    *map(str, tmp.rglob('*.java'))], check=True)
+    subprocess.run(['java', '-cp', str(tmp), 'ThemeLoaderTest'], check=True)
