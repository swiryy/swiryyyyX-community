+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.data;
+
+import android.graphics.Canvas;
+import android.view.View;
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.R;
+import org.thunderdog.challegram.component.chat.MessageView;
+import org.thunderdog.challegram.component.chat.MessagesManager;
+import org.thunderdog.challegram.component.sticker.TGStickerObj;
+import org.thunderdog.challegram.core.Lang;
+import org.thunderdog.challegram.loader.ComplexReceiver;
+import org.thunderdog.challegram.loader.ImageReceiver;
+import org.thunderdog.challegram.loader.gif.GifReceiver;
+import org.thunderdog.challegram.tool.Screen;
+import org.thunderdog.challegram.ui.SettingsStarsController;
+import org.thunderdog.challegram.ui.SviriProfileController;
+
+/** Render the gift types provided by this pinned TDLib instead of Unsupported message. */
+public final class TGMessageTelegramGift extends TGMessageGiveawayBase {
+  private final TdApi.MessageContent giftContent;
+  public TGMessageTelegramGift (MessagesManager manager, TdApi.Message message) {
+    super(manager, message); giftContent = message.content;
+  }
+  private boolean stars () { return giftContent instanceof TdApi.MessageGiftedStars || giftContent instanceof TdApi.MessageGiveawayPrizeStars; }
+  @Override protected int onBuildContent (int maxWidth) {
+    TdApi.Sticker sticker = null;
+    String title, details = "", caption = "";
+    if (giftContent instanceof TdApi.MessageGift) {
+      TdApi.MessageGift value = (TdApi.MessageGift) giftContent;
+      sticker = value.gift.sticker; title = Lang.getString(R.string.SviriReceivedGift);
+      details = value.gift.starCount + " ★";
+      if (value.wasRefunded) details += " · " + Lang.getString(R.string.SviriRefund);
+      else if (value.wasConverted) details += " · " + Lang.getString(R.string.SviriGiftConverted);
+      else if (value.wasUpgraded) details += " · " + Lang.getString(R.string.SviriGiftUpgraded);
+      if (value.text != null) caption = value.text.text;
+    } else if (giftContent instanceof TdApi.MessageUpgradedGift) {
+      TdApi.MessageUpgradedGift value = (TdApi.MessageUpgradedGift) giftContent;
+      sticker = value.gift.model.sticker; title = value.gift.title + " #" + value.gift.number;
+      details = value.gift.model.name + " · " + value.gift.backdrop.name;
+      if (value.text != null) caption = value.text.text;
+    } else if (giftContent instanceof TdApi.MessageGiftedStars) {
+      TdApi.MessageGiftedStars value = (TdApi.MessageGiftedStars) giftContent;
+      sticker = value.sticker; title = value.starCount + " ★"; details = Lang.getString(R.string.SviriStarsGift);
+    } else {
+      TdApi.MessageGiveawayPrizeStars value = (TdApi.MessageGiveawayPrizeStars) giftContent;
+      sticker = value.sticker; title = value.starCount + " ★"; details = Lang.getString(R.string.SviriStarsPrize);
+    }
+    content = new Content(maxWidth - Screen.dp(CONTENT_PADDING_DP * 2));
+    content.padding(Screen.dp(12));
+    if (sticker != null) content.add(new GiftSticker(sticker));
+    else content.add(new ContentDrawable(R.drawable.baseline_gift_72));
+    content.padding(Screen.dp(12));
+    content.add(Lang.boldify(title), getTextColorSet(), currentViews);
+    content.padding(Screen.dp(6)); content.add(details, getTextColorSet(), currentViews);
+    if (!caption.isEmpty()) { content.padding(Screen.dp(10)); content.add(caption, getTextColorSet(), currentViews); }
+    invalidateGiveawayReceiver(); return content.getHeight();
+  }
+  @Override protected String getButtonText () { return Lang.getString(stars() ? R.string.SviriStars : giftContent instanceof TdApi.MessageUpgradedGift ? R.string.SviriOpenGift : R.string.SviriGifts); }
+  @Override public void onClick (View view, TGInlineKeyboard keyboard, TGInlineKeyboard.Button button) {
+    if (giftContent instanceof TdApi.MessageUpgradedGift) {
+      tdlib.ui().openUrl(controller(), "https://t.me/nft/" + ((TdApi.MessageUpgradedGift) giftContent).gift.name, null);
+    } else if (stars()) controller().navigateTo(new SettingsStarsController(view.getContext(), tdlib, false));
+    else controller().navigateTo(new SviriProfileController(view.getContext(), tdlib, false));
+  }
+  @Override public boolean onLongClick (View view, TGInlineKeyboard keyboard, TGInlineKeyboard.Button button) { return false; }
+  private final class GiftSticker extends ContentPart {
+    private final TGStickerObj object;
+    private int width;
+    GiftSticker (TdApi.Sticker sticker) { object = new TGStickerObj(tdlib, sticker, null, sticker.fullType); }
+    @Override public void build (int maxWidth) { width = maxWidth; }
+    @Override public int getWidth () { return Math.min(width, Screen.dp(150)); }
+    @Override public int getHeight () { return Screen.dp(150); }
+    @Override public void requestFiles (ComplexReceiver receiver) {
+      receiver.getImageReceiver(1).requestFile(object.isAnimated() ? object.getImage() : object.getFullImage());
+      receiver.getGifReceiver(1).requestFile(object.getPreviewAnimation());
+    }
+    @Override public void draw (Canvas canvas, MessageView view, int x, int y) {
+      int left = x + (width - getWidth()) / 2;
+      ImageReceiver image = view.getGiveawayAvatarsReceiver().getImageReceiver(1);
+      GifReceiver animation = view.getGiveawayAvatarsReceiver().getGifReceiver(1);
+      image.setBounds(left, y, left + getWidth(), y + getHeight());
+      animation.setBounds(left, y, left + getWidth(), y + getHeight());
+      if (!object.isAnimated() || animation.needPlaceholder()) image.draw(canvas);
+      if (object.isAnimated()) animation.draw(canvas);
+    }
+  }
+}
