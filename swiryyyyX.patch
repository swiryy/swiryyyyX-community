@@ -0,0 +1,40 @@
+import java.util.*;
+import java.util.function.Consumer;
+import org.thunderdog.challegram.telegram.FolderForwardQueue;
+public class FolderForwardQueueTest {
+  static void check(boolean v){if(!v)throw new AssertionError();}
+  static class Clock implements FolderForwardQueue.Scheduler {
+    long now;ArrayDeque<Runnable> scheduled=new ArrayDeque<>();
+    public void later(Runnable r,long delay){check(delay==200);scheduled.add(()->{now+=delay;r.run();});}
+    void tick(){scheduled.remove().run();}
+  }
+  static class Transport implements FolderForwardQueue.Transport {
+    ArrayList<Integer> sent=new ArrayList<>();Consumer<String> reply;
+    public void send(int i,Consumer<String> cb){sent.add(i);reply=cb;}
+  }
+  static class Result implements FolderForwardQueue.Listener {
+    int done,total,finished,errors;
+    public void progress(int d,int t){done=d;total=t;}
+    public void finished(){finished++;}
+    public void failed(String e){errors++;}
+  }
+  public static void main(String[] args){
+    Clock clock=new Clock();Transport transport=new Transport();Result result=new Result();
+    FolderForwardQueue q=new FolderForwardQueue(400,transport,clock,result);
+    q.start();q.start();check(transport.sent.equals(List.of(0))&&result.done==0);
+    for(int i=0;i<400;i++){
+      check(transport.sent.size()==i+1&&result.done==i);
+      Consumer<String> callback=transport.reply;callback.accept(null);callback.accept(null);
+      check(result.done==i+1);
+      if(i<399){check(transport.sent.size()==i+1);clock.tick();}
+    }
+    check(clock.now==399*200L&&result.finished==1&&result.errors==0);
+    Clock c=new Clock();Transport t=new Transport();Result r=new Result();
+    FolderForwardQueue fail=new FolderForwardQueue(3,t,c,r);fail.start();t.reply.accept(null);c.tick();t.reply.accept("FLOOD_WAIT_10");
+    check(r.done==1&&r.errors==1&&c.scheduled.isEmpty()&&t.sent.size()==2);
+    FolderForwardQueue cancel=new FolderForwardQueue(3,t,c,new Result());cancel.start();t.reply.accept(null);cancel.cancel();c.tick();check(t.sent.size()==3);
+    check(FolderForwardQueue.retrySeconds("FLOOD_WAIT_12")==12&&FolderForwardQueue.retrySeconds("Too Many Requests: retry after 7")==7);
+    check(FolderForwardQueue.retrySeconds("CHAT_WRITE_FORBIDDEN")==0);
+    System.out.println("PASS: 400 sequential chats, exact 200ms gaps, acknowledgements, repeated taps, duplicate callbacks, cancel and FLOOD_WAIT stop");
+  }
+}
diff --git a/tests/sviri/HiddenChatStoreTest.java b/tests/sviri/HiddenChatStoreTest.java
new file mode 100644
index 0000000..168442f
--- /dev/null
+++ b/tests/sviri/HiddenChatStoreTest.java
@@ -0,0 +1,71 @@
+import org.thunderdog.challegram.telegram.HiddenChatStore;
+import java.util.Arrays;
+
+public class HiddenChatStoreTest {
+  static class Memory implements HiddenChatStore.Storage {
+    long[] ids;
+    int writes;
+    boolean fail;
+    @Override public long[] read () { return ids; }
+    @Override public void write (long[] value) {
+      if (fail) throw new IllegalStateException("disk error");
+      ids = value.clone();
+      writes++;
+    }
+  }
+
+  static void check (boolean value, String message) {
+    if (!value) throw new AssertionError(message);
+  }
+
+  public static void main (String[] args) throws Exception {
+    Memory accountOne = new Memory();
+    HiddenChatStore store = new HiddenChatStore(accountOne);
+    check(store.isEmpty(), "new account");
+    check(!store.setHidden(0, true), "zero chat id rejected");
+    check(store.setHidden(-123456L, true), "groups use negative identifiers");
+    check(!store.setHidden(-123456L, true), "repeated hide is idempotent");
+    check(accountOne.writes == 1, "no redundant persistence");
+    check(new HiddenChatStore(accountOne).contains(-123456L), "restart retains hidden chats");
+    check(new HiddenChatStore(new Memory()).isEmpty(), "accounts stay independent");
+    long[] copy = store.chatIds();
+    copy[0] = 99;
+    check(store.contains(-123456L) && !store.contains(99), "snapshot cannot mutate visibility");
+    check(store.setHidden(-123456L, false), "unhide works");
+    check(new HiddenChatStore(accountOne).isEmpty(), "unhide persists");
+
+    accountOne.fail = true;
+    try { store.setHidden(7, true); throw new AssertionError("failed write accepted"); }
+    catch (IllegalStateException expected) { }
+    check(!store.contains(7), "failed persistence leaves previous state intact");
+    accountOne.fail = false;
+
+    Memory bulkMemory = new Memory();
+    HiddenChatStore bulk = new HiddenChatStore(bulkMemory);
+    long[] selection = new long[402];
+    for (int i = 0; i < 400; i++) selection[i] = i + 1;
+    selection[400] = 0;
+    selection[401] = 1;
+    check(bulk.setHidden(selection, true).length == 400, "bulk selection deduplicates and rejects zero");
+    check(bulkMemory.writes == 1, "400 chats persisted in one operation");
+    check(bulk.setHidden(selection, true).length == 0 && bulkMemory.writes == 1, "bulk hide idempotent");
+    bulkMemory.fail = true;
+    try { bulk.setHidden(selection, false); throw new AssertionError("failed bulk accepted"); }
+    catch (IllegalStateException expected) { }
+    check(bulk.chatIds().length == 400, "failed bulk write preserves the whole previous state");
+
+    Thread[] workers = new Thread[4];
+    for (int n = 0; n < workers.length; n++) {
+      final int base = n * 100;
+      workers[n] = new Thread(() -> {
+        for (int i = 1; i <= 100; i++) store.setHidden(base + i, true);
+      });
+      workers[n].start();
+    }
+    for (Thread worker : workers) worker.join();
+    check(store.chatIds().length == 400, "concurrent changes do not lose chats");
+    check(Arrays.equals(store.chatIds(), accountOne.ids), "saved snapshot matches live state");
+    for (int i = 1; i <= 400; i++) check(store.contains(i), "400-chat lookup");
+    System.out.println("PASS: persistence, account isolation, snapshots, failed writes, concurrency, 400 chats");
+  }
+}
