@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.ui;
+
+import android.content.Context;
+import android.view.View;
+
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.R;
+import org.thunderdog.challegram.core.Lang;
+import org.thunderdog.challegram.telegram.Tdlib;
+import org.thunderdog.challegram.telegram.TdlibSettingsManager;
+import org.thunderdog.challegram.telegram.TdlibUi;
+import org.thunderdog.challegram.v.CustomRecyclerView;
+
+import java.util.ArrayList;
+
+public final class SettingsHiddenChatsController extends RecyclerViewController<Void>
+    implements View.OnClickListener, TdlibSettingsManager.HiddenChatsListener {
+  private SettingsAdapter adapter;
+
+  public SettingsHiddenChatsController (Context context, Tdlib tdlib) {
+    super(context, tdlib);
+  }
+
+  @Override public int getId () { return R.id.controller_hiddenChats; }
+  @Override public CharSequence getName () { return Lang.getString(R.string.SviriHiddenChats); }
+
+  @Override
+  protected void onCreateView (Context context, CustomRecyclerView recyclerView) {
+    adapter = new SettingsAdapter(this);
+    recyclerView.setAdapter(adapter);
+    tdlib.settings().addHiddenChatsListener(this);
+    rebuildItems();
+    for (long chatId : tdlib.settings().hiddenChatIds()) {
+      if (tdlib.chat(chatId) == null) {
+        tdlib.chat(chatId, () -> new TdApi.GetChat(chatId), chat -> runOnUiThreadOptional(this::rebuildItems));
+      }
+    }
+  }
+
+  private void rebuildItems () {
+    if (adapter == null || isDestroyed()) return;
+    ArrayList<ListItem> items = new ArrayList<>();
+    items.add(new ListItem(ListItem.TYPE_DESCRIPTION, 0, 0, R.string.SviriHiddenChatsHint));
+    long[] hidden = tdlib.settings().hiddenChatIds();
+    if (hidden.length == 0) {
+      items.add(new ListItem(ListItem.TYPE_EMPTY, 0, 0, R.string.SviriNoHiddenChats));
+    } else {
+      items.add(new ListItem(ListItem.TYPE_SHADOW_TOP));
+      for (int i = 0; i < hidden.length; i++) {
+        long chatId = hidden[i];
+        TdApi.Chat chat = tdlib.chat(chatId);
+        String title = chat != null ? chat.title : Long.toString(chatId);
+        items.add(new ListItem(ListItem.TYPE_SETTING, R.id.btn_hiddenChat, R.drawable.baseline_eye_off_24, title).setLongId(chatId));
+        if (i + 1 < hidden.length) items.add(new ListItem(ListItem.TYPE_SEPARATOR));
+      }
+      items.add(new ListItem(ListItem.TYPE_SHADOW_BOTTOM));
+    }
+    adapter.setItems(items, false);
+  }
+
+  @Override
+  public void onClick (View view) {
+    if (view.getId() != R.id.btn_hiddenChat || !(view.getTag() instanceof ListItem)) return;
+    long chatId = ((ListItem) view.getTag()).getLongId();
+    showOptions(tdlib.chatTitle(chatId),
+      new int[] {R.id.btn_openHiddenChat, R.id.btn_unhideChat},
+      new String[] {Lang.getString(R.string.SviriOpenHiddenChat), Lang.getString(R.string.SviriUnhideChat)},
+      null, new int[] {R.drawable.baseline_chat_bubble_24, R.drawable.baseline_visibility_24},
+      (itemView, id) -> {
+        if (id == R.id.btn_openHiddenChat) {
+          tdlib.ui().openChat(this, chatId, new TdlibUi.ChatOpenParameters().keepStack());
+        } else if (id == R.id.btn_unhideChat) {
+          tdlib.settings().setChatHidden(chatId, false);
+        }
+        return true;
+      });
+  }
+
+  @Override
+  public void onHiddenChatChanged (long chatId) {
+    runOnUiThreadOptional(this::rebuildItems);
+  }
+
+  @Override
+  public void destroy () {
+    tdlib.settings().removeHiddenChatsListener(this);
+    super.destroy();
+  }
+}
