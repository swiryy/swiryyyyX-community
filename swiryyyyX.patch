diff --git a/app/src/main/java/org/thunderdog/challegram/telegram/Tdlib.java b/app/src/main/java/org/thunderdog/challegram/telegram/Tdlib.java
index 11c4bfb..6c15959 100644
--- a/app/src/main/java/org/thunderdog/challegram/telegram/Tdlib.java
+++ b/app/src/main/java/org/thunderdog/challegram/telegram/Tdlib.java
@@ -494,6 +494,69 @@ public class Tdlib implements TdlibProvider, Settings.SettingsChangeListener, Da
     return counter;
   }
 
+  /** Local display counters. Raw TDLib counters remain untouched. */
+  @NonNull
+  public TdlibCounter getVisibleCounter (@NonNull TdApi.ChatList chatList) {
+    synchronized (dataLock) {
+      TdlibCounter raw = getCounter(chatList);
+      HiddenCounterProjection projection = new HiddenCounterProjection();
+      String listKey = TD.makeChatListKey(chatList);
+      for (long chatId : settings().hiddenChatIds()) {
+        TdApi.Chat chat = chats.get(chatId);
+        if (chat == null) continue;
+        boolean belongs = false;
+        if (chat.chatLists != null) {
+          for (TdApi.ChatList membership : chat.chatLists) {
+            if (listKey.equals(TD.makeChatListKey(membership))) { belongs = true; break; }
+          }
+        }
+        if (!belongs && chat.positions != null) {
+          for (TdApi.ChatPosition position : chat.positions) {
+            if (position.order != 0 && listKey.equals(TD.makeChatListKey(position.list))) { belongs = true; break; }
+          }
+        }
+        if (belongs) projection.add(chat.unreadCount, chat.isMarkedAsUnread, chatNotificationsEnabled(chat));
+      }
+      return new TdlibCounter(
+        projection.visible(HiddenCounterProjection.TOTAL, raw.totalChatCount),
+        projection.visible(HiddenCounterProjection.CHATS, raw.chatCount),
+        projection.visible(HiddenCounterProjection.UNMUTED_CHATS, raw.chatUnmutedCount),
+        projection.visible(HiddenCounterProjection.MARKED, raw.markedAsUnreadCount),
+        projection.visible(HiddenCounterProjection.UNMUTED_MARKED, raw.markedAsUnreadUnmutedCount),
+        projection.visible(HiddenCounterProjection.MESSAGES, raw.messageCount),
+        projection.visible(HiddenCounterProjection.UNMUTED_MESSAGES, raw.messageUnmutedCount));
+    }
+  }
+
+  @TdlibThread
+  public void refreshLocalVisibilityCounters () {
