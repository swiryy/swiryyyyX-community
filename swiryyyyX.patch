@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/** Local chat visibility. One instance belongs to one Telegram account. */
+public final class HiddenChatStore {
+  public interface Storage {
+    long[] read ();
+    void write (long[] chatIds);
+  }
+
+  private final Storage storage;
+  private volatile Snapshot hidden;
+
+  public HiddenChatStore (Storage storage) {
+    this.storage = storage;
+    Set<Long> initial = new HashSet<>();
+    long[] saved = storage.read();
+    if (saved != null) {
+      for (long chatId : saved) {
+        if (chatId != 0) initial.add(chatId);
+      }
+    }
+    hidden = new Snapshot(initial);
+  }
+
+  public boolean contains (long chatId) {
+    return hidden.ids.contains(chatId);
+  }
+
+  public boolean isEmpty () {
+    return hidden.ids.isEmpty();
+  }
+
+  public long[] chatIds () {
+    return hidden.sorted.clone();
+  }
+
+  public boolean setHidden (long chatId, boolean value) {
+    return setHidden(new long[] {chatId}, value).length != 0;
+  }
+
+  public synchronized long[] setHidden (long[] chatIds, boolean value) {
+    Set<Long> updated = new HashSet<>(hidden.ids);
+    Set<Long> changed = new HashSet<>();
+    for (long chatId : chatIds) {
+      if (chatId != 0 && (value ? updated.add(chatId) : updated.remove(chatId))) changed.add(chatId);
+    }
+    if (changed.isEmpty()) return new long[0];
+    Snapshot snapshot = new Snapshot(updated);
+    storage.write(snapshot.sorted.clone());
+    hidden = snapshot;
+    return toArray(changed);
+  }
+
+  private static final class Snapshot {
+    final Set<Long> ids;
+    final long[] sorted;
+    Snapshot (Set<Long> ids) {
+      this.ids = java.util.Collections.unmodifiableSet(ids);
+      this.sorted = toArray(ids);
+    }
+  }
+
+  private static long[] toArray (Set<Long> ids) {
+    long[] result = new long[ids.size()];
+    int index = 0;
+    for (long id : ids) result[index++] = id;
+    java.util.Arrays.sort(result);
+    return result;
+  }
+}
diff --git a/app/src/main/java/org/thunderdog/challegram/telegram/HiddenCounterProjection.java b/app/src/main/java/org/thunderdog/challegram/telegram/HiddenCounterProjection.java
new file mode 100644
index 0000000..40aa890
--- /dev/null
+++ b/app/src/main/java/org/thunderdog/challegram/telegram/HiddenCounterProjection.java
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+/** Subtract local hidden-chat contributions without changing server counters. */
+public final class HiddenCounterProjection {
+  public static final int TOTAL = 0, CHATS = 1, UNMUTED_CHATS = 2,
+    MARKED = 3, UNMUTED_MARKED = 4, MESSAGES = 5, UNMUTED_MESSAGES = 6;
+  private final long[] hidden = new long[7];
+
+  public void add (int unreadMessages, boolean markedUnread, boolean unmuted) {
+    hidden[TOTAL]++;
+    if (unreadMessages > 0 || markedUnread) {
+      hidden[CHATS]++;
+      if (unmuted) hidden[UNMUTED_CHATS]++;
+    }
+    if (markedUnread) {
+      hidden[MARKED]++;
+      if (unmuted) hidden[UNMUTED_MARKED]++;
+    }
+    hidden[MESSAGES] += Math.max(0, unreadMessages);
+    if (unmuted) hidden[UNMUTED_MESSAGES] += Math.max(0, unreadMessages);
+  }
+
+  public int visible (int field, int serverValue) {
+    // -1 means the server count is not known yet, not an empty list.
+    return serverValue < 0 ? serverValue : (int) Math.max(0L, (long) serverValue - hidden[field]);
+  }
+}
