+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.ui;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.widget.CheckBox;
+import android.widget.LinearLayout;
+import android.widget.Toast;
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.R;
+import org.thunderdog.challegram.navigation.ViewController;
+import org.thunderdog.challegram.util.SenderPickerDelegate;
+import org.thunderdog.challegram.core.Lang;
+import org.thunderdog.challegram.data.TD;
+import org.thunderdog.challegram.telegram.GiftPaymentTask;
+import org.thunderdog.challegram.telegram.GiftSendPolicy;
+import org.thunderdog.challegram.telegram.Tdlib;
+import org.thunderdog.challegram.tool.Screen;
+import org.thunderdog.challegram.tool.UI;
+import java.util.HashMap;
+import java.util.function.Consumer;
+
+/** Recipient lookup, fresh quote and explicit confirmation for a single gift. */
+final class SviriGiftFlow {
+  private static final HashMap<Integer, SviriGiftFlow> active = new HashMap<>();
+  private final Context context;
+  private final ViewController<?> owner;
+  private final Tdlib tdlib;
+  private final Runnable changed;
+  private AlertDialog dialog;
+  private boolean closed, writing, privateSender;
+  private int generation;
+  private long giftId, userId, sourceUserId;
+  private String receivedId, recipient;
+  SviriGiftFlow (ViewController<?> owner, Tdlib tdlib, Runnable changed) {
+    this.owner = owner; this.context = owner.context(); this.tdlib = tdlib; this.changed = changed;
+  }
+  void purchase (TdApi.Gift gift) { if (begin()) { giftId = gift.id; receivedId = null; chooseRecipient(); } }
+  void transfer (TdApi.ReceivedGift gift) {
+    if (gift == null || gift.receivedGiftId == null || gift.receivedGiftId.isEmpty()) { toast(Lang.getString(R.string.SviriGiftCannotTransfer)); return; }
+    if (begin()) { receivedId = gift.receivedGiftId; chooseRecipient(); }
+  }
+  private boolean begin () {
+    if (closed) return false;
+    if (active.containsKey(tdlib.id())) { toast(Lang.getString(R.string.SviriGiftBusy)); return false; }
+    active.put(tdlib.id(), this); privateSender = false; sourceUserId = tdlib.myUserId(); generation++; return true;
+  }
+  private void release () { if (active.get(tdlib.id()) == this) active.remove(tdlib.id()); }
+  private void cancel () { generation++; release(); }
+  void destroy () { closed = true; generation++; if (dialog != null) dialog.dismiss(); if (!writing) release(); }
+  private void toast (String value) { UI.showToast(value, Toast.LENGTH_LONG); }
+  private void fail (String value) { if (dialog != null) dialog.dismiss(); if (!closed) toast(value); cancel(); }
+  private String error (TdApi.Object result) { return result instanceof TdApi.Error ? TD.toErrorString(result) : Lang.getString(R.string.SviriUnexpectedResponse); }
+  private void read (TdApi.Function<?> request, Consumer<TdApi.Object> callback) {
+    int token = generation;
+    Runnable timeout = () -> { if (!closed && token == generation) fail(Lang.getString(R.string.SviriGiftReadFailed)); };
+    UI.post(timeout, 30000L);
+    tdlib.client().send(request, result -> UI.post(() -> {
+      UI.removePendingRunnable(timeout);
+      if (!closed && token == generation && active.get(tdlib.id()) == this) {
+        if (sourceUserId != tdlib.myUserId()) { fail(Lang.getString(R.string.SviriAccountChanged)); return; }
+        callback.accept(result);
+      }
+    }));
+  }
+  private void chooseRecipient () {
+    final boolean[] chosen = {false};
+    ContactsController picker = new ContactsController(context, tdlib) {
+      @Override public void destroy () { if (!chosen[0]) SviriGiftFlow.this.cancel(); super.destroy(); }
+    };
+    picker.setArguments(new ContactsController.Args(new SenderPickerDelegate() {
+      @Override public boolean allowGlobalSearch () { return true; }
+      @Override public String getUserPickTitle () { return Lang.getString(R.string.SviriGiftRecipient); }
+      @Override public boolean onSenderPick (ContactsController controller, android.view.View view, TdApi.MessageSender sender) {
+        if (chosen[0] || closed) return false;
+        if (!(sender instanceof TdApi.MessageSenderUser) || ((TdApi.MessageSenderUser) sender).userId == sourceUserId) {
+          toast(Lang.getString(R.string.SviriGiftUserOnly)); return false;
+        }
+        chosen[0] = true;
+        long id = ((TdApi.MessageSenderUser) sender).userId;
+        read(new TdApi.GetUser(id), result -> {
+          if (!(result instanceof TdApi.User)) { fail(error(result)); return; }
+          TdApi.User user = (TdApi.User) result;
+          if (user.id != id) { fail(Lang.getString(R.string.SviriUnexpectedResponse)); return; }
+          if (!(user.type instanceof TdApi.UserTypeRegular)) { fail(Lang.getString(R.string.SviriGiftUserOnly)); return; }
+          userId = id;
+          String username = user.usernames != null && user.usernames.activeUsernames.length > 0 ? "@" + user.usernames.activeUsernames[0] + " · " : "";
+          recipient = user.firstName + " " + user.lastName + "\n" + username + "ID " + id;
+          prepare(null);
+        });
+        return true;
+      }
+    }));
+    if (!owner.navigateTo(picker)) cancel();
+  }
+  private void prepare (GiftSendPolicy.Confirmation approved) {
+    if (receivedId != null) read(new TdApi.GetReceivedGift(receivedId), result -> {
+      if (!(result instanceof TdApi.ReceivedGift)) { fail(error(result)); return; }
+      TdApi.ReceivedGift gift = (TdApi.ReceivedGift) result;
+      if (!receivedId.equals(gift.receivedGiftId) || !GiftSendPolicy.transferable(gift, System.currentTimeMillis() / 1000L)) {
+        fail(Lang.getString(R.string.SviriGiftCannotTransfer)); return;
+      }
+      TdApi.UpgradedGift upgraded = ((TdApi.SentGiftUpgraded) gift.gift).gift;
+      quote(upgraded.title + " #" + upgraded.number, gift.transferStarCount, approved);
+    });
+    else read(new TdApi.GetAvailableGifts(), result -> {
+      if (!(result instanceof TdApi.AvailableGifts)) { fail(error(result)); return; }
+      TdApi.Gift found = null;
+      for (TdApi.AvailableGift entry : ((TdApi.AvailableGifts) result).gifts) if (entry.gift.id == giftId) { found = entry.gift; break; }
+      if (!GiftSendPolicy.available(found)) { fail(Lang.getString(R.string.SviriGiftUnavailable)); return; }
+      TdApi.Gift gift = found;
+      TdApi.User self = tdlib.cache().user(tdlib.myUserId());
+      if (gift.isPremium && (self == null || !self.isPremium)) { fail(Lang.getString(R.string.SviriGiftPremium)); return; }
+      Runnable ready = () -> quote(gift.sticker.emoji + " · " + Lang.getString(R.string.SviriReceivedGift), gift.starCount, approved);
+      if (gift.nextSendDate > System.currentTimeMillis() / 1000L) read(new TdApi.CanSendGift(gift.id), value -> {
+        if (value instanceof TdApi.CanSendGiftResultOk) ready.run();
+        else fail(value instanceof TdApi.CanSendGiftResultFail ? ((TdApi.CanSendGiftResultFail) value).reason.text : error(value));
+      }); else ready.run();
+    });
+  }
+  private void quote (String title, long price, GiftSendPolicy.Confirmation approved) {
+    read(new TdApi.GetStarTransactions(new TdApi.MessageSenderUser(tdlib.myUserId()), "", null, "", 1), result -> {
+      if (!(result instanceof TdApi.StarTransactions)) { fail(error(result)); return; }
+      TdApi.StarAmount balance = ((TdApi.StarTransactions) result).starAmount;
+      if (!GiftSendPolicy.enoughStars(balance, price)) { fail(Lang.getString(R.string.SviriGiftInsufficient, price)); return; }
+      if (approved != null && approved.consume(userId, price)) { send(price); return; }
+      if (approved != null) toast(Lang.getString(R.string.SviriGiftPriceChanged));
+      GiftSendPolicy.Confirmation confirmation = new GiftSendPolicy.Confirmation(userId, price);
+      LinearLayout content = new LinearLayout(context); content.setOrientation(LinearLayout.VERTICAL);
+      android.widget.TextView details = new android.widget.TextView(context);
+      details.setText(title + "\n\n" + recipient + "\n\n" + Lang.getString(R.string.SviriGiftTotal, price));
+      details.setPadding(Screen.dp(24), Screen.dp(12), Screen.dp(24), Screen.dp(12)); content.addView(details);
+      CheckBox privacy = new CheckBox(context); privacy.setText(R.string.SviriGiftPrivate); privacy.setChecked(privateSender);
+      if (receivedId == null) content.addView(privacy);
+      final boolean[] confirmed = {false};
+      dialog = new AlertDialog.Builder(context).setTitle(receivedId == null ? R.string.SviriGiftBuy : R.string.SviriGiftTransferAction)
+        .setView(content).setNegativeButton(R.string.Cancel, (d, which) -> cancel())
+        .setPositiveButton(Lang.getString(R.string.SviriGiftConfirm, price), (d, which) -> {
+          if (confirmed[0] || writing || closed) return;
+          confirmed[0] = true;
+          privateSender = privacy.isChecked(); prepare(confirmation);
+        }).create();
+      dialog.setOnCancelListener(d -> cancel()); dialog.show();
+    });
+  }
+  private void send (long price) {
+    if (closed || writing) return;
+    if (sourceUserId != tdlib.myUserId()) { fail(Lang.getString(R.string.SviriAccountChanged)); return; }
+    TdApi.Function<?> request = receivedId != null
+      ? new TdApi.TransferGift("", receivedId, new TdApi.MessageSenderUser(userId), price)
+      : new TdApi.SendGift(giftId, new TdApi.MessageSenderUser(userId), new TdApi.FormattedText("", new TdApi.TextEntity[0]), privateSender, false);
+    writing = true;
+    if (!GiftPaymentTask.send(tdlib, request, result -> {
+      writing = false; release();
+      if (result instanceof TdApi.Ok) {
+        toast(Lang.getString(R.string.SviriGiftSent)); if (!closed) changed.run();
+      } else toast(error(result) + "\n" + Lang.getString(R.string.SviriGiftCheckBeforeRetry));
+    })) { writing = false; fail(Lang.getString(R.string.SviriGiftBusy)); }
+    else toast(Lang.getString(R.string.SviriGiftSending));
+  }
+}
