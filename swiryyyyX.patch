+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.R;
+import org.thunderdog.challegram.core.Lang;
+import org.thunderdog.challegram.data.TD;
+import org.thunderdog.challegram.telegram.Tdlib;
+import org.thunderdog.challegram.theme.ColorId;
+import org.thunderdog.challegram.theme.Theme;
+import org.thunderdog.challegram.tool.Screen;
+import org.thunderdog.challegram.v.CustomRecyclerView;
+import java.math.BigDecimal;
+import java.text.DateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.function.Consumer;
+
+/** Live account balance, independent of paginated transaction history. */
+public final class SettingsStarsController extends RecyclerViewController<Void> {
+  private final ArrayList<TdApi.StarTransaction> entries = new ArrayList<>();
+  private final HashSet<String> seen = new HashSet<>();
+  private String offset = "", error;
+  private boolean loading, loaded;
+  private int filter, generation;
+  private HistoryAdapter adapter;
+  private final Consumer<TdApi.StarAmount> balanceListener = value -> {
+    if (!isDestroyed() && adapter != null) adapter.notifyItemChanged(0);
+  };
+  public SettingsStarsController (Context context, Tdlib tdlib, boolean gifts) { super(context, tdlib); }
+  @Override public int getId () { return R.id.controller_sviriStars; }
+  @Override public CharSequence getName () { return Lang.getString(R.string.SviriStars); }
+  @Override protected void onCreateView (Context context, CustomRecyclerView recycler) {
+    adapter = new HistoryAdapter(); recycler.setAdapter(adapter); recycler.setItemAnimator(null);
+    recycler.setPadding(Screen.dp(12), Screen.dp(8), Screen.dp(12), Screen.dp(16));
+    tdlib.addStarAmountListener(balanceListener); load();
+  }
+  public static String amount (TdApi.StarAmount value) {
+    return BigDecimal.valueOf(value.starCount).add(BigDecimal.valueOf(value.nanostarCount, 9)).stripTrailingZeros().toPlainString();
+  }
+  private void load () {
+    if (loading || isDestroyed() || (loaded && offset.isEmpty() && error == null)) return;
+    loading = true; error = null; update();
+    final int token = generation;
+    final long userId = tdlib.myUserId(), revision = tdlib.ownedStarAmountRevision();
+    TdApi.TransactionDirection direction = filter == 1 ? new TdApi.TransactionDirectionIncoming() : filter == 2 ? new TdApi.TransactionDirectionOutgoing() : null;
+    tdlib.client().send(new TdApi.GetStarTransactions(new TdApi.MessageSenderUser(userId), "", direction, offset, 30), result -> runOnUiThreadOptional(() -> {
+      if (isDestroyed() || token != generation || userId != tdlib.myUserId()) return;
+      loading = false;
+      if (result instanceof TdApi.StarTransactions) {
+        TdApi.StarTransactions page = (TdApi.StarTransactions) result;
+        tdlib.rememberOwnedStarAmount(userId, revision, page.starAmount);
+        for (TdApi.StarTransaction transaction : page.transactions) if (seen.add(transaction.id)) entries.add(transaction);
+        offset = page.nextOffset; loaded = true;
+      } else error = result instanceof TdApi.Error ? TD.toErrorString(result) : Lang.getString(R.string.SviriUnexpectedResponse);
+      update();
+    }));
+  }
+  private void reset (int nextFilter) {
+    generation++; filter = nextFilter; loading = false; loaded = false; offset = ""; error = null;
+    entries.clear(); seen.clear(); load();
+  }
+  private void update () { if (adapter != null && !isDestroyed()) adapter.notifyDataSetChanged(); }
+  private LinearLayout column (Context context) {
+    LinearLayout wrap = new LinearLayout(context); wrap.setOrientation(LinearLayout.VERTICAL);
+    wrap.setLayoutParams(new RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+    wrap.setPadding(Screen.dp(14), Screen.dp(10), Screen.dp(14), Screen.dp(10));
+    return wrap;
+  }
+  private TextView label (Context context, CharSequence value, int size, int color) {
+    TextView text = new TextView(context); text.setText(value); text.setTextSize(size);
+    text.setTextColor(color); text.setPadding(Screen.dp(8), Screen.dp(8), Screen.dp(8), Screen.dp(8));
+    addThemeInvalidateListener(text);
+    return text;
+  }
+  private String title (TdApi.StarTransaction transaction) {
+    TdApi.StarTransactionType type = transaction.type;
+    if (type instanceof TdApi.StarTransactionTypeGiftPurchase || type instanceof TdApi.StarTransactionTypeUpgradedGiftPurchase || type instanceof TdApi.StarTransactionTypeGiftUpgradePurchase) return Lang.getString(R.string.SviriGiftPurchase);
+    if (type instanceof TdApi.StarTransactionTypeGiftSale || type instanceof TdApi.StarTransactionTypeUpgradedGiftSale) return Lang.getString(R.string.SviriGiftSale);
+    if (type instanceof TdApi.StarTransactionTypeGiftUpgrade) return Lang.getString(R.string.SviriGiftUpgrade);
