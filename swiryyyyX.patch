@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+import java.util.function.Consumer;
+
+/** One acknowledged chat batch at a time, with a minimum 200 ms gap. No automatic retries. */
+public final class FolderForwardQueue {
+  public static final long CHAT_DELAY_MS = 200L;
+  public interface Transport { void send (int index, Consumer<String> result); }
+  public interface Scheduler { void later (Runnable action, long delayMs); }
+  public interface Listener { void progress (int completed, int total); void finished (); void failed (String error); }
+  private final int total;
+  private final Transport transport;
+  private final Scheduler scheduler;
+  private final Listener listener;
+  private int completed, generation;
+  private boolean active, started;
+  public FolderForwardQueue (int total, Transport transport, Scheduler scheduler, Listener listener) {
+    this.total = total; this.transport = transport; this.scheduler = scheduler; this.listener = listener;
+  }
+  public void start () { if (started) return; started = true; active = true; listener.progress(0, total); send(++generation); }
+  public int completed () { return completed; }
+  public boolean active () { return active; }
+  public void cancel () { active = false; generation++; }
+  private void send (int token) {
+    if (!active || token != generation) return;
+    if (completed >= total) { cancel(); listener.finished(); return; }
+    final int index = completed;
+    transport.send(index, error -> {
+      if (!active || token != generation || index != completed) return;
+      if (error != null) { cancel(); listener.failed(error); return; }
+      completed++; listener.progress(completed, total);
+      if (completed == total) { cancel(); listener.finished(); }
+      else scheduler.later(() -> send(token), CHAT_DELAY_MS);
+    });
+  }
+  public static long retrySeconds (String error) {
+    if (error == null) return 0;
+    java.util.regex.Matcher matcher = java.util.regex.Pattern.compile("(?:FLOOD_WAIT_|retry after\\s+)([0-9]+)", java.util.regex.Pattern.CASE_INSENSITIVE).matcher(error);
+    if (!matcher.find()) return 0;
+    try { return Long.parseLong(matcher.group(1)); } catch (NumberFormatException ignored) { return 0; }
+  }
+}
diff --git a/app/src/main/java/org/thunderdog/challegram/telegram/FolderForwardSender.java b/app/src/main/java/org/thunderdog/challegram/telegram/FolderForwardSender.java
new file mode 100644
index 0000000..7e2c6ac
--- /dev/null
+++ b/app/src/main/java/org/thunderdog/challegram/telegram/FolderForwardSender.java
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.data.TD;
+import org.thunderdog.challegram.tool.UI;
+import org.thunderdog.challegram.unsorted.Settings;
+import java.util.List;
+import java.util.HashSet;
+import java.util.HashMap;
+import java.util.function.Consumer;
+
+/** Await actual TDLib send-success updates, including album messages and early replies. */
+public final class FolderForwardSender implements MessageListener {
+  private final Tdlib tdlib;
+  private long chatId;
+  private List<TdApi.Function<?>> functions;
+  private int next, generation;
+  private Consumer<String> complete;
+  private boolean awaitingResult;
+  private final HashSet<Long> pending = new HashSet<>(), earlySuccess = new HashSet<>();
+  private final HashMap<Long, TdApi.Error> earlyErrors = new HashMap<>();
+  private final HashMap<Long, Double> earlyWait = new HashMap<>();
+  private Runnable timeout;
+  public FolderForwardSender (Tdlib tdlib) { this.tdlib = tdlib; }
+  public void send (long chatId, List<TdApi.Function<?>> functions, Consumer<String> complete) {
+    cancel(); this.chatId = chatId; this.functions = functions; this.complete = complete; next = 0;
+    tdlib.listeners().subscribeToMessageUpdates(chatId, this); next();
+  }
+  public void cancel () {
+    generation++;
+    if (chatId != 0) tdlib.listeners().unsubscribeFromMessageUpdates(chatId, this);
+    if (timeout != null) UI.removePendingRunnable(timeout);
+    timeout = null; complete = null; functions = null; chatId = 0;
+    pending.clear(); earlySuccess.clear(); earlyErrors.clear(); earlyWait.clear(); awaitingResult = false;
+  }
+  private void finish (String error) { Consumer<String> callback = complete; cancel(); if (callback != null) callback.accept(error); }
+  private void fail (TdApi.Error error, double retryAfter) {
+    long seconds = Math.max(FolderForwardQueue.retrySeconds(error.message), (long) Math.ceil(retryAfter));
+    if (seconds > 0 && seconds < (Long.MAX_VALUE - System.currentTimeMillis()) / 1000L) {
+      String key = "sviri_forward_cooldown_" + tdlib.id();
+      Settings.instance().putLong(key, Math.max(Settings.instance().getLong(key, 0), System.currentTimeMillis() + seconds * 1000L));
+    }
+    finish(TD.toErrorString(error));
+  }
+  private void next () {
+    if (complete == null) return;
+    if (next >= functions.size()) { finish(null); return; }
+    pending.clear(); earlySuccess.clear(); earlyErrors.clear(); earlyWait.clear(); awaitingResult = true;
+    int token = ++generation;
+    if (timeout != null) UI.removePendingRunnable(timeout);
+    timeout = () -> { if (complete != null && token == generation) finish("Telegram did not confirm delivery. Remaining chats were not sent."); };
+    UI.post(timeout, 60000L);
+    tdlib.client().send(functions.get(next++), result -> {
+      // Preserve Telegram X cache and message-list updates even if the picker was closed.
+      if (result instanceof TdApi.Message || result instanceof TdApi.Messages) tdlib.messageHandler().onResult(result);
+      UI.post(() -> {
+      if (complete == null || token != generation) return;
+      if (result instanceof TdApi.Error) { fail((TdApi.Error) result, 0); return; }
+      TdApi.Message[] messages = result instanceof TdApi.Message ? new TdApi.Message[]{(TdApi.Message) result} : result instanceof TdApi.Messages ? ((TdApi.Messages) result).messages : null;
+      if (messages == null || messages.length == 0) { finish("Telegram returned no forwarded messages."); return; }
+      for (TdApi.Message message : messages) {
+        if (message == null) { finish("Telegram could not forward one of the selected messages."); return; }
+        if (message.sendingState instanceof TdApi.MessageSendingStateFailed) {
+          TdApi.MessageSendingStateFailed failure = (TdApi.MessageSendingStateFailed) message.sendingState;
+          fail(failure.error, failure.retryAfter); return;
+        }
+        TdApi.Error earlyError = earlyErrors.get(message.id);
+        if (earlyError != null) { fail(earlyError, earlyWait.getOrDefault(message.id, 0d)); return; }
+        if (message.sendingState != null && !earlySuccess.contains(message.id)) pending.add(message.id);
+      }
+      awaitingResult = false;
+      if (pending.isEmpty()) next();
+      });
+    });
+  }
+  @Override public void onMessageSendSucceeded (TdApi.Message message, long oldMessageId) {
+    UI.post(() -> {
+      if (complete == null || message.chatId != chatId) return;
+      if (awaitingResult) { if (earlySuccess.size() < 1000) earlySuccess.add(oldMessageId); return; }
+      if (pending.remove(oldMessageId) && pending.isEmpty()) next();
+    });
+  }
+  @Override public void onMessageSendFailed (TdApi.Message message, long oldMessageId, TdApi.Error error) {
+    UI.post(() -> {
+      if (complete == null || message.chatId != chatId) return;
+      if (awaitingResult) {
+        if (earlyErrors.size() < 1000) {
+          earlyErrors.put(oldMessageId, error);
+          if (message.sendingState instanceof TdApi.MessageSendingStateFailed) earlyWait.put(oldMessageId, ((TdApi.MessageSendingStateFailed) message.sendingState).retryAfter);
+        }
+        return;
+      }
+      if (pending.contains(oldMessageId)) {
+        double retryAfter = message.sendingState instanceof TdApi.MessageSendingStateFailed ? ((TdApi.MessageSendingStateFailed) message.sendingState).retryAfter : 0;
+        fail(error, retryAfter);
+      }
+    });
+  }
+}
